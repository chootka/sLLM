# Static server for the object. Install to /etc/systemd/system/.
[Unit]
Description=drift, static server
After=network.target

[Service]
Type=simple
User=chootka
WorkingDirectory=/home/chootka/drift
ExecStart=/usr/bin/python3 /home/chootka/drift/serve.py 8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
