# Chromium in kiosk mode, one page, no chrome, sound without a click.
# Install to ~/.config/autostart/drift-kiosk.desktop on the object.
#
# Flags that are load-bearing, and why:
#
#   --autoplay-policy=no-user-gesture-required
#       The page starts its AudioContext on the SOUND ON touch. Without this
#       Chromium can still refuse that first context on a page it considers
#       to have had no real interaction, and the piece stays silent.
#   --check-for-update-interval=31536000
#       A Chromium update prompt over the field is the one piece of platform
#       infrastructure the work does not need.
#   --disable-session-crashed-bubble, --restore-last-session=false
#       The buyer will unplug it. Without these the next boot puts a
#       "Chromium didn't shut down correctly / Restore pages?" bar across the
#       top of the artwork, and there is no keyboard to dismiss it.
#   --disable-pinch, --overscroll-history-navigation=0
#       Touch panel. Stops a two-finger stray from zooming the field and a
#       horizontal swipe from navigating the page away.
#   --touch-events=enabled
#       Forces touch support on regardless of what Chromium detects at boot,
#       which is not reliable when the panel enumerates after the browser.
#   --password-store=basic
#       Stops a fresh Pi desktop popping a keyring unlock dialog on first run.
[Desktop Entry]
Type=Application
Name=drift
Exec=/usr/bin/chromium-browser --kiosk --incognito --noerrdialogs --disable-infobars --hide-scrollbars --disable-pinch --overscroll-history-navigation=0 --touch-events=enabled --autoplay-policy=no-user-gesture-required --check-for-update-interval=31536000 --disable-session-crashed-bubble --restore-last-session=false --password-store=basic --disable-features=Translate,TranslateUI http://127.0.0.1:8080/drift
X-GNOME-Autostart-enabled=true
