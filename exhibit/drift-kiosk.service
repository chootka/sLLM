# The piece, on Raspberry Pi OS Lite. Install to /etc/systemd/system/ and
#   sudo systemctl enable --now drift-kiosk
#
# Lite has no desktop and no display manager, so there is no ~/.config/autostart
# to put a .desktop file in. cage is a kiosk Wayland compositor: it takes the
# console, runs one fullscreen client, and nothing else. That is the whole
# session.
#
# Load-bearing details:
#
#   PAMName=login + TTYPath=/dev/tty1
#       Gives the unit a real login session on seat0. Without it cage cannot
#       take a seat and dies with "Could not open target tty: Permission
#       denied".
#   XDG_RUNTIME_DIR
#       systemd does not set it for a service. cage exits immediately without
#       it. 1000 is the first user; check with `id -u chootka` if that differs.
#   Restart=always
#       The buyer unplugs it. If chromium or cage ever dies, this brings the
#       piece back rather than leaving a console prompt on the wall.
#   Conflicts=getty@tty1.service
#       getty owns tty1 by default and cage cannot take a console another
#       process is holding. Without this the service starts, exits cleanly with
#       no error output at all, and restarts forever while the display shows a
#       login prompt. Also run once, by hand:
#           sudo systemctl disable --now getty@tty1
#       Conflicts stops it for as long as the piece runs; disable stops it
#       coming back on the next boot. Ctrl+Alt+F2 still gets a console.
#   The browser is /usr/bin/chromium
#       Trixie's name for it. Bookworm and earlier called it
#       chromium-browser -- correct this line if the object is ever rebuilt on
#       an older image.
#   the offline flags
#       This object never needs a network. Chromium was seen registering with
#       Google push services and failing -- QUOTA_EXCEEDED, DEPRECATED_ENDPOINT
#       -- at the moment clicking resumed during a test, and background
#       networking stalls in bursts rather than steadily, which is the shape of
#       this fault. Correct for a sealed object either way.
#   ?speed=12
#       One pass of the 62.5 h recording every 5.2 hours. Drop it for real
#       time, which is two and a half days a pass.
[Unit]
Description=drift, the piece
Requires=drift-server.service
After=drift-server.service seatd.service systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

# Measured on the object, not guessed: while the piece played and clicked, the
# ALSA stream went XRUN six times in thirty seconds, cycling SETUP -> PREPARED
# between them -- chromium losing the device and reopening it, and the reopen
# is the click. No chromium thread had real-time priority at all while the
# renderer sat at 100% of a core.
#
# LimitRTPRIO is what lets chromium's request for a real-time audio thread
# succeed; without it the call fails and the thread stays at normal priority
# against a busy renderer.
[Service]
Type=simple
User=chootka
LimitRTPRIO=95
LimitNICE=-15
Nice=-10
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=LIBSEAT_BACKEND=seatd
# Chromium picks its audio backend at startup: PulseAudio if it can reach a
# server, otherwise it opens the ALSA hardware directly and holds it
# exclusively. It has been taking the direct path here, which is the fragile
# one -- a native OscillatorNode with no JS in the audio path underruns on it,
# while aplay to the same DAC is clean for five minutes. Pointing it at
# pipewire's pulse socket puts an elastic buffer between the browser and the
# hardware.
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
    --kiosk \
    --incognito \
    --noerrdialogs \
    --disable-infobars \
    --hide-scrollbars \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    --touch-events=enabled \
    --autoplay-policy=no-user-gesture-required \
    --check-for-update-interval=31536000 \
    --disable-session-crashed-bubble \
    --restore-last-session=false \
    --password-store=basic \
    --disable-background-networking \
    --disable-component-update \
    --disable-domain-reliability \
    --disable-sync \
    --disable-breakpad \
    --disable-client-side-phishing-detection \
    --no-first-run \
    --no-default-browser-check \
    --disable-features=Translate,TranslateUI,OptimizationHints,MediaRouter,CalculateNativeWinOcclusion \
    http://127.0.0.1:8080/drift?speed=12
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
